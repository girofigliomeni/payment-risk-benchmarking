{
  "name": "payment-risk-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n core,api,dashboard \"npm run dev -w @payment-risk/core\" \"npm run dev -w @payment-risk/api\" \"npm run dev -w @payment-risk/dashboard\"",
    "typecheck": "npm run build -w @payment-risk/core && npm run typecheck --workspaces",
    "lint": "eslint .",
    "build": "npm run build -w @payment-risk/core && npm run build -w @payment-risk/api && npm run build -w @payment-risk/dashboard && npm run build -w @payment-risk/sdk && npm run build -w @payment-risk/simulator",
    "test": "vitest run",
    "test:storage": "node scripts/test-storage.mjs",
    "test:protection-storage": "node scripts/test-protection-storage.mjs",
    "test:protection-concurrency": "node scripts/test-protection-concurrency.mjs",
    "protection:operator": "node apps/api/dist/protection/operator.js",
    "simulate": "node packages/simulator/dist/cli.js",
    "baseline": "node apps/api/dist/experiments/cli.js",
    "tunnel:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-ngrok.ps1",
    "tunnel:check": "node scripts/ngrok.mjs --check",
    "tunnel": "node scripts/ngrok.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.13.0",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
