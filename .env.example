# Optional local configuration. Copy to .env at the repository root.
HOST=127.0.0.1
PORT=3001
VITE_API_BASE_URL=http://127.0.0.1:3001

# Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal Sandbox: server only. Apps & Credentials > Sandbox in the PayPal Developer Dashboard.
# Missing values disable checkout with setup_required; never use VITE_ prefixes.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the webhook registered on the same Sandbox REST app.
PAYPAL_WEBHOOK_ID=
# Locally generated access code (32 to 256 characters), entered only in the local checkout form.
CHECKOUT_ACCESS_KEY=
# Exact dashboard origin, no trailing slash. Local sandbox defaults only.
CHECKOUT_ORIGIN=http://127.0.0.1:5173
# Fixed USD test purchase in integer minor units (1 to 10000); no client amount override.
CHECKOUT_AMOUNT_MINOR=100

# OpenAI.
OPENAI_API_KEY=

# Local webhook tunnel. Obtain from https://dashboard.ngrok.com/get-started/your-authtoken
# Server/tooling only; never prefix this with VITE_.
NGROK_AUTHTOKEN=
